  const WA = '5491123862480';

  function values(){
    const f = new FormData(form);
    const g = k => (f.get(k) || '').toString().trim();
    return {
      nombre: g('nombre'), empresa: g('empresa'), email: g('email'),
      telefono: g('telefono'), tipo: g('tipo'), plazo: g('plazo'), mensaje: g('mensaje')
    };
  }
  function resumen(d){
    return [
      'Nombre: ' + d.nombre,
      d.empresa && ('Empresa: ' + d.empresa),
      'Email: ' + d.email,
      d.telefono && ('Teléfono: ' + d.telefono),
      'Tipo de proyecto: ' + d.tipo,
      'Plazo estimado: ' + d.plazo,
      '',
      'Consulta:',
      d.mensaje
    ].filter(Boolean).join('\n');
  }
  function valido(){
    if (form.reportValidity()) return true;
    status.style.color = '#ff9b9b';
    status.textContent = 'Faltan datos: completá los campos marcados con *.';
    return false;
  }
  function aviso(texto){
    status.style.color = 'var(--accent-dark)';
    status.textContent = texto;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!valido()) return;
