<script>
(function(){
  const DIR = 'maincarrousel/';
  const REPO_API = 'https://api.github.com/repos/FerreroIgnacio/SiSoftwareLanding/contents/maincarrousel';
  const IMG = /\.(jpe?g|png|webp|gif|avif)$/i;
  // Texto por foto (clave: inicio del nombre). x/y en % del cuadro, ubicados sobre zonas lisas de cada imagen.
  const COPY = {
    '1bbb351a': { lines: ['¿Necesitás organizar', 'tu mercadería?'], x: 57, y: 28, tone: 'dark' },
    '2db4c6c6': { lines: ['¿Necesitás centralizar', 'tu información?'], x: 15, y: 13, tone: 'light' },
    '5759ab6f': { lines: ['¿Necesitás un', 'equipo cercano?'], x: 63, y: 26, tone: 'dark' },
    'db91e8d3': { lines: ['¿Necesitás', 'trabajar tranquilo?'], x: 60, y: 12, tone: 'dark' },
    'fb3036ad': { lines: ['¿Necesitás dar', 'el salto?'], x: 58, y: 15, tone: 'light' }
  };
  const track = document.querySelector('.hero-track');
  if (!track) return;

  // Lista las fotos: primero el listado del servidor (local / autoindex), si no la API de GitHub (GitHub Pages)
  function fromListing(){
    return fetch(DIR).then(r => {
      if (!r.ok) throw 0;
      return r.text();
    }).then(html => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const names = [...doc.querySelectorAll('a')]
        .map(a => decodeURIComponent((a.getAttribute('href') || '').split('/').pop()))
        .filter(n => IMG.test(n));
      if (!names.length) throw 0;
      return names;
    });
  }
  function fromGitHub(){
    return fetch(REPO_API).then(r => {
      if (!r.ok) throw 0;
      return r.json();
    }).then(items => items.filter(f => f.type === 'file' && IMG.test(f.name)).map(f => f.name));
  }

  fromListing().catch(fromGitHub).then(names => {
    [...new Set(names)].sort().forEach(n => {
      const slide = document.createElement('div');
      slide.className = 'hero-slide';
      const img = document.createElement('img');
      img.src = DIR + encodeURIComponent(n);
      img.alt = '';
      slide.appendChild(img);
      const c = COPY[n.slice(0, 8)];
      if (c) {
        const cap = document.createElement('div');
        cap.className = 'hero-caption ' + c.tone;
        cap.style.left = c.x + '%';
        cap.style.top = c.y + '%';
        c.lines.concat('Si').forEach((t, k, all) => {
          const span = document.createElement('span');
          span.className = k === all.length - 1 ? 'si' : 'q';
          span.textContent = t;
          cap.appendChild(span);
        });
        slide.appendChild(cap);
      }
      track.appendChild(slide);
    });
    start();
  }).catch(() => {});

  function start(){
  const count = track.children.length;
  if (count > 1) track.appendChild(track.children[0].cloneNode(true));
  const slides = track.children;
  // Activa el slide idx (el texto hace fade-in); instant: sin fade, para los saltos invisibles del loop
  function setActive(idx, instant){
    [...slides].forEach((s, k) => { if (k !== idx) s.classList.remove('active'); });
    const s = slides[idx];
    if (instant) s.classList.add('instant');
    s.classList.add('active');
    if (instant) { void s.offsetWidth; s.classList.remove('instant'); }
  }
  setActive(0);
  if (count < 2) return;
  let i = 0, timer, busy = false;
  function place(animate){
    track.style.transition = animate ? '' : 'none';
    track.style.transform = 'translateX(' + (-i * 100) + '%)';
    if (!animate) void track.offsetWidth;
  }
  function go(dir){
    if (busy) return;
    if (dir < 0 && i === 0) { i = count; place(false); setActive(count, true); }
    busy = true;
    i += dir;
    place(true);
    setActive(i);
  }
  track.addEventListener('transitionend', e => {
    if (e.target !== track) return;
    busy = false;
    if (i === count) { i = 0; place(false); setActive(0, true); }
  });
  function restart(){
    clearInterval(timer);
    timer = setInterval(() => go(1), 5000);
  }
  document.querySelectorAll('.hero-arrow').forEach(btn => {
    btn.addEventListener('click', () => { go(Number(btn.dataset.dir)); restart(); });
  });
  restart();
  }
})();
</script>

