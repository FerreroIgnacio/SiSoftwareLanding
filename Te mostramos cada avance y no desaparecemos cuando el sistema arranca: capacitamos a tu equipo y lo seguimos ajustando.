<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Si Soluciones en Software</title>
<meta name="description" content="Si Soluciones en Software — modernizamos e implementamos infraestructura de software para operaciones que ya funcionan. Desarrollo a medida y desarrollo web.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%23d95f02'/%3E%3Ccircle cx='50' cy='50' r='38' stroke='white' stroke-width='5' fill='none'/%3E%3Ctext x='50' y='66' text-anchor='middle' font-family='Arial' font-weight='800' font-size='42' fill='white'%3ESi%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --accent: #d95f02;
    --accent-2: #f07f1d;
    --accent-dark: #a84800;
    --white: #ffffff;
    --ink: #1f1a17;
    --muted: #6b625a;
    --bg-soft: #fff6ee;
    --radius: 18px;
    --font-head: "Space Grotesk", "Segoe UI", sans-serif;
    --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--white);
    line-height: 1.5;
    overflow-x:hidden;
  }
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  h1,h2,h3,h4{ font-family: var(--font-head); }
  .container{
    width:100%;
    max-width:1140px;
    margin:0 auto;
    padding:0 24px;
  }

  /* ---------- reveal on scroll ---------- */
  .reveal{
    opacity:0;
    transform: translateY(24px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.in{ opacity:1; transform:none; }

  /* ---------- NAV ---------- */
  header{
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.25) 70%, rgba(255,255,255,0) 100%);
  }
  .brand, .nav-links a{ text-shadow: 0 0 10px rgba(255,255,255,0.9); }
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 14px 24px;
    max-width:1140px;
    margin:0 auto;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--ink);
    font-family: var(--font-head);
    font-weight:600;
    font-size:1.05rem;
    letter-spacing:0.01em;
  }
  .brand .mark{width:34px;height:34px;}
  .nav-links{
    display:flex;
    gap:30px;
    list-style:none;
  }
  .nav-links a{
    color: var(--ink);
    font-size:0.92rem;
    font-weight:500;
    position:relative;
    padding-bottom:4px;
    opacity:0.85;
    transition: opacity .2s;
  }
  .nav-links a::after{
    content:"";
    position:absolute; left:0; bottom:0;
    width:0; height:1.5px;
    background: var(--accent);
    transition: width .25s ease;
  }
  .nav-links a:hover{ opacity:1; }
  .nav-links a:hover::after{ width:100%; }
  .nav-cta{
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    padding: 9px 20px;
    border-radius: 999px;
    font-weight:600;
    font-size:0.88rem;
    white-space:nowrap;
    box-shadow: 0 6px 20px rgba(240,125,26,0.3);
    transition: transform .2s ease;
  }
  .nav-cta:hover{ transform: translateY(-2px); }

  @media (max-width: 780px){
    .nav-links{ display:none; }
    .nav-cta{ padding:8px 16px; font-size:0.82rem; }
  }

  /* ---------- HERO ---------- */
  .hero{
    background: var(--white);
    color: var(--ink);
    padding: 0;
    position:relative;
    overflow:hidden;
  }
  .hero-stage{
    position:relative;
    aspect-ratio: 16 / 9;
    max-height: 100vh;
    width:100%;
    background: var(--bg-soft);
  }
  .hero-carousel{
    position:absolute; inset:0;
    overflow:hidden;
    pointer-events:none;
  }
  .hero-track{
    display:flex;
    height:100%;
    transition: transform .6s ease;
  }
  .hero-slide{
    flex:0 0 100%;
    position:relative;
    overflow:hidden;
  }
  .hero-slide img{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover;
    filter: brightness(.86);
  }
  .hero-caption{
    position:absolute;
    z-index:1;
    font-family: var(--font-head);
    font-weight:700;
    letter-spacing:-0.02em;
    color: var(--ink);
    text-shadow: 0 1px 14px rgba(255,255,255,0.7);
    opacity:0;
    transition: opacity .9s ease .3s;
  }
  .hero-caption .q{
    display:block;
    font-size: clamp(.7rem, 3vw, 3.4rem);
    line-height:1.1;
    white-space:nowrap;
  }
  .hero-caption .si{
    display:block;
    font-size: clamp(2rem, 9vw, 10rem);
    line-height:1;
    margin-top:.1em;
    color: var(--accent);
    opacity:0;
    transition: opacity .9s ease 1.2s;
  }
  .hero-caption.light{ color:#fff; text-shadow: 0 2px 16px rgba(0,0,0,0.5); }
  .hero-slide.active .hero-caption,
  .hero-slide.active .hero-caption .si{ opacity:1; }
  .hero-slide.instant .hero-caption,
  .hero-slide.instant .hero-caption .si{ transition:none; }
  .sr-only{
    position:absolute; width:1px; height:1px;
    overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap;
  }
  .hero-arrow{
    position:absolute; top:50%;
    z-index:2;
    width:96px; height:80px;
    padding:0; border:0;
    background:none;
    color:var(--ink);
    cursor:pointer;
  }
  .hero-arrow::before{
    content:"";
    position:absolute; right:6px; top:50%;
    width:66px; height:62px;
    transform:translateY(-50%);
    border-radius:52% 48% 46% 54% / 55% 50% 50% 45%;
    background:rgba(222,212,200,0.85);
  }
  .hero-arrow:hover::before{ background:#ec9a43; }
  .hero-arrow svg{
    position:relative;
    width:100%; height:100%;
    display:block;
    transform:translateX(-14px);
    transition:transform .25s ease;
  }
  .hero-arrow:hover svg{ transform:translateX(10px); }
  .hero-arrow[data-dir="-1"]{ left:16px; transform:translateY(-50%) scaleX(-1); }
  .hero-arrow[data-dir="1"]{ right:16px; transform:translateY(-50%); }

  .hero-inner{
    position:relative;
    max-width:1140px;
    width:100%;
    margin:0 auto;
    padding: 36px 24px 52px;
    text-align:left;
  }
  .hero p.lead{
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    color: rgba(31,26,23,0.88);
    max-width: 520px;
    margin: 0 0 28px;
  }
  .hero-actions{
    display:flex;
    gap:14px;
    flex-wrap:wrap;
    justify-content:flex-start;
  }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight:600;
    font-size:0.95rem;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .btn:hover{ transform: translateY(-2px); }
  .btn-primary{
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    box-shadow: 0 10px 30px rgba(240,125,26,0.35);
  }
  .btn-outline{
    background: rgba(31,26,23,0.04);
    color: var(--ink);
    border: 1px solid rgba(31,26,23,0.25);
  }
  .btn-outline:hover{ background: rgba(31,26,23,0.09); }

  @media (max-width: 900px){
    .hero-inner{ padding-top:10px; }
  }

  /* ---------- SECTIONS ---------- */
  section{ padding: 96px 24px; }
  .section-head{
    text-align:center;
    max-width: 640px;
    margin: 0 auto 52px;
  }
  .eyebrow{
    display:inline-block;
    color: var(--accent-dark);
    background: rgba(240,125,26,0.12);
    font-weight:700;
    font-size:0.76rem;
    letter-spacing:0.09em;
    text-transform:uppercase;
    padding:6px 14px;
    border-radius:999px;
    margin-bottom:18px;
  }
  .cta-heading{ color: var(--accent) !important; }
  .section-head h2{
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    font-weight:700;
    letter-spacing:-0.01em;
    color: #fff;
    margin-bottom:14px;
  }
  .section-head p{ color: var(--muted); font-size:1.03rem; }

  /* Quiénes somos */
  .about{
    background:
      radial-gradient(circle at 15% 10%, rgba(240,125,26,0.14), transparent 45%),
      radial-gradient(circle at 85% 90%, rgba(255,173,92,0.10), transparent 45%),
      var(--white);
    color: var(--ink);
  }
  .about .eyebrow{
    color: var(--accent-dark);
    background: rgba(240,125,26,0.14);
  }
  .about .section-head h2{ color: var(--ink); }
  .about .section-head p{ color: rgba(31,26,23,0.72); }
  .about-rows{
    max-width: 1000px;
    margin: 0 auto;
  }
  .about-row{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items:center;
    padding: 44px 0;
    border-bottom: 1px solid rgba(31,26,23,0.08);
  }
  .about-row:last-child{ border-bottom:none; }
  .about-row:nth-child(even) .about-art{ order:2; }
  .about-art{
    border: 2px solid rgba(240,125,26,0.22);
    border-radius: 18px;
    overflow:hidden;
    background:#000;
  }
  .about-art img{
    display:block;
    width:100%;
    height:auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .about-step{
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-row h3{
    font-size: 1.7rem;
    color: var(--ink);
    margin: 8px 0 10px;
  }
  .about-row p{
    color: rgba(31,26,23,0.72);
    font-size: 0.98rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .about-list{
    list-style:none;
    padding:0;
    margin:0;
  }
  .about-list li{
    position:relative;
    padding: 4px 0 4px 24px;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .about-list li::before{
    content:"✓";
    position:absolute;
    left:0;
    color: var(--accent);
    font-weight:700;
  }
  .about-stat{
    display:flex;
    align-items:center;
    gap:16px;
    margin-top:20px;
    padding: 14px 18px;
    border: 1px solid rgba(31,26,23,0.1);
    border-radius: 14px;
    background: var(--white);
  }
  .about-stat strong{
    font-family: var(--font-head);
    font-size: 1.9rem;
    line-height:1;
    color: var(--accent);
    white-space:nowrap;
  }
  .about-stat span{
    font-size: 0.88rem;
    color: rgba(31,26,23,0.72);
  }
  @media (max-width: 820px){
    .about-row{ grid-template-columns:1fr; gap:24px; padding:32px 0; }
    .about-row:nth-child(even) .about-art{ order:0; }
  }

  /* Process */
  /* ángulo animado del borde (rotación del degradé cónico) */
  @property --bd-angle{ syntax:'<angle>'; initial-value:0deg; inherits:false; }
  /* brillo del borde bajo el cursor: registrado para poder transicionarlo */
  @property --edge-glow{ syntax:'<color>'; initial-value:rgba(255,214,173,0); inherits:false; }

  .process{
    /* fondo más claro que las cards: la separación la da el contraste, no el borde */
    background:
      radial-gradient(circle at 12% 8%, rgba(240,125,26,0.18), transparent 50%),
      radial-gradient(circle at 88% 92%, rgba(255,173,92,0.12), transparent 48%),
      linear-gradient(180deg, var(--bg-soft) 0%, #fff1e4 100%);
    color: var(--ink);
  }
  .process .eyebrow{ color: var(--accent-dark); background: rgba(240,125,26,0.14); }
  .process .section-head h2{ color: var(--ink); }
  .process .section-head p{ color: rgba(31,26,23,0.8); }
  .process-grid{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .process-card{
    /* intensidad del borde: estos valores son el "hover" anterior en reposo */
    --ring-dim: rgba(240,125,26,0.38);
    --ring-mid: rgba(240,125,26,0.95);
    --ring-hot: #ffd6ad;
    --ring-w: 3px;
    --spin: 7s;
    position:relative;
    z-index:1;
    text-align:left;
    background-color: var(--white);
    border-radius: 20px;
    aspect-ratio: 3 / 4.3;
    display:flex;
    flex-direction:column;
    justify-content:flex-start;
    padding: 30px 24px;
    overflow:hidden;
    isolation:isolate;
    cursor:pointer;
    will-change: transform;
    transform: perspective(900px) rotateX(0) rotateY(0) translateY(0) scale(1);
    transition: transform .15s ease-out, box-shadow .35s ease, --edge-glow .35s ease;
    box-shadow: 0 14px 34px rgba(0,0,0,0.08), 0 0 0 1px rgba(240,125,26,0.10);
  }
  /* borde animado: un "cometa" de luz que gira, en un solo color de marca.
     El reflejo bajo el cursor se suma como segunda capa sobre el mismo anillo. */
  .process-card::before{
    content:"";
    position:absolute;
    inset:0;
    border-radius:inherit;
    padding: var(--ring-w);
    background:
      radial-gradient(130px circle at var(--mx,50%) var(--my,50%), var(--edge-glow), transparent 62%),
      conic-gradient(from var(--bd-angle),
        var(--ring-dim) 0deg,
        var(--ring-mid) 55deg,
        var(--ring-hot) 88deg,
        var(--ring-mid) 120deg,
        var(--ring-dim) 190deg,
        var(--ring-dim) 360deg);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: ring-spin var(--spin) linear infinite;
    pointer-events:none;
    z-index:2;
  }
  @keyframes ring-spin{ to{ --bd-angle: 360deg; } }
  /* brillo suave interior que también sigue al mouse */
  .process-card::after{
    content:"";
    position:absolute;
    inset:0;
    border-radius:inherit;
    background: radial-gradient(260px circle at var(--mx,50%) var(--my,50%), rgba(240,125,26,0.22), transparent 62%);
    opacity:0;
    transition: opacity .35s ease;
    pointer-events:none;
    z-index:0;
  }
  .process-card:hover::after{ opacity:1; }
  .process-card:hover{
    /* hover: mismo color, bastante más fuerte, y gira más rápido */
    --ring-dim: rgba(240,125,26,0.62);
    --ring-mid: #ff9d4a;
    --ring-hot: var(--accent-dark);
    --ring-w: 4px;
    --spin: 3.2s;
    --edge-glow: rgba(255,200,150,0.95);
    box-shadow: 0 26px 52px rgba(0,0,0,0.12), 0 0 32px rgba(240,125,26,0.35), 0 0 0 1px rgba(240,125,26,0.35);
  }
  .process-card > *{ position:relative; z-index:1; }
  .process-card .step-num{
    width:46px; height:46px;
    border-radius:50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-family: var(--font-head);
    font-weight:700;
    display:flex; align-items:center; justify-content:center;
    margin-bottom:24px;
    flex-shrink:0;
    box-shadow: 0 8px 18px rgba(240,125,26,0.35);
  }
  .process-card h4{ font-size:1.1rem; font-weight:700; color:var(--ink); margin-bottom:10px; }
  .process-card p{ font-size:0.9rem; color:rgba(31,26,23,0.75); }

  /* número gigante de fondo */
  .process-card .card-num{
    position:absolute;
    top:-6px; right:10px;
    z-index:0;
    font-family: var(--font-head);
    font-weight:700;
    font-size:5.6rem;
    line-height:1;
    letter-spacing:-0.04em;
    color: rgba(31,26,23,0.055);
    pointer-events:none;
    transition: color .35s ease;
  }
  .process-card:hover .card-num{ color: rgba(240,125,26,0.16); }

  /* ilustración animada al pie de la card */
  .card-art{
    margin-top:auto;
    padding-top:18px;
    /* verde agua: se despega del azul del borde y del texto */
    color: var(--accent-2);
    opacity:.45;
    transition: opacity .35s ease, filter .35s ease;
  }
  .process-card:hover .card-art{
    opacity:1;
    filter: drop-shadow(0 0 10px rgba(255,173,92,0.45));
  }
  .card-art svg{ width:100%; height:auto; display:block; overflow:visible; }

  .art-bar{ transform-box: fill-box; transform-origin: bottom; animation: bar-pulse 2.6s ease-in-out infinite; }
  .art-bar:nth-of-type(2){ animation-delay:.35s; }
  .art-bar:nth-of-type(3){ animation-delay:.7s; }
  .art-bar:nth-of-type(4){ animation-delay:1.05s; }
  @keyframes bar-pulse{ 0%,100%{ transform:scaleY(.65);} 50%{ transform:scaleY(1);} }

  .art-lens{ transform-box: fill-box; transform-origin:center; animation: lens-scan 4.5s ease-in-out infinite; }
  @keyframes lens-scan{ 0%,100%{ transform:translate(0,0);} 50%{ transform:translate(-26px,10px);} }

  .art-route{ stroke-dasharray: 8 9; animation: dash-run 3.5s linear infinite; }
  @keyframes dash-run{ to{ stroke-dashoffset:-34; } }

  .art-node{ transform-box: fill-box; transform-origin:center; animation: node-pop 3s ease-in-out infinite; }
  .art-node:nth-of-type(2){ animation-delay:.6s; }
  .art-node:nth-of-type(3){ animation-delay:1.2s; }
  @keyframes node-pop{ 0%,55%,100%{ transform:scale(.7); opacity:.45; } 25%{ transform:scale(1.25); opacity:1; } }

  .art-packet{ animation: packet-up 2.4s ease-in-out infinite; }
  .art-packet:nth-of-type(2){ animation-delay:.8s; }
  .art-packet:nth-of-type(3){ animation-delay:1.6s; }
  @keyframes packet-up{
    0%{ transform:translateY(12px); opacity:0; }
    25%{ opacity:1; }
    100%{ transform:translateY(-30px); opacity:0; }
  }

  .art-wave{ transform-box: fill-box; transform-origin:center; animation: wave-out 2.8s ease-out infinite; }
  .art-wave:nth-of-type(2){ animation-delay:.9s; }
  .art-wave:nth-of-type(3){ animation-delay:1.8s; }
  @keyframes wave-out{ 0%{ transform:scale(.35); opacity:.9; } 100%{ transform:scale(1.25); opacity:0; } }

  .art-dot{ animation: dot-blink 1.5s ease-in-out infinite; }
  .art-dot:nth-of-type(2){ animation-delay:.2s; }
  .art-dot:nth-of-type(3){ animation-delay:.4s; }
  @keyframes dot-blink{ 0%,100%{ opacity:.3; } 50%{ opacity:1; } }

  @media (prefers-reduced-motion: reduce){
    .process-card::before,
    .card-art *{ animation:none !important; }
  }

  @media (max-width: 900px){
    .process-grid{ grid-template-columns: repeat(2, 1fr); max-width:520px; }
  }
  @media (max-width: 520px){
    .process-grid{ grid-template-columns:1fr; }
    .process-card{ aspect-ratio:auto; }
  }

  /* Contact */
  .contact{
    background:
      radial-gradient(circle at 80% 0%, rgba(240,125,26,0.14), transparent 45%),
      radial-gradient(circle at 10% 100%, rgba(255,173,92,0.08), transparent 45%),
      var(--white);
  }
  .contact .eyebrow{ color: var(--accent-dark); background: rgba(240,125,26,0.12); }
  .contact .section-head h2{ color: var(--ink); }
  .contact .section-head p{ color: rgba(31,26,23,0.72); }

  .contact-layout{
    display:grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 26px;
    max-width: 1000px;
    margin: 0 auto;
    align-items:start;
  }
  .contact-card{
    position:relative;
    border-radius: 22px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(240,125,26,0.55), rgba(255,173,92,0.35) 60%, rgba(240,125,26,0.2));
    box-shadow: 0 24px 60px rgba(0,0,0,0.1);
  }
  .contact-card-inner{
    background: var(--white);
    border-radius: 20px;
    padding: 34px 32px;
    text-align:left;
  }
  .contact-card h3{
    font-size:1.25rem;
    font-weight:700;
    color: var(--ink);
    margin-bottom:6px;
  }
  .contact-card .form-hint{
    color: rgba(31,26,23,0.6);
    font-size:0.9rem;
    margin-bottom: 24px;
  }

  /* formulario */
  .form-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field{ display:flex; flex-direction:column; gap:7px; }
  .field.full{ grid-column: 1 / -1; }
  .field label{
    font-size:0.78rem;
    font-weight:600;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color: rgba(31,26,23,0.62);
  }
  .field label .req{ color: var(--accent); }
  .field input,
  .field select,
